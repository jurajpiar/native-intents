{
  "name": "native-intent-poc",
  "version": "0.0.1",
  "private": true,
  "description": "Entry point for the whole PoC \u2014 contracts, stacks, and the SDK's experiments and attack board. The thing under test is all of it, so this is where you run from.",
  "scripts": {
    "stack:up": "docker-compose -f stack/podman-compose.yml up -d",
    "stack:build": "docker-compose -f stack/podman-compose.yml build",
    "stack:rebuild": "docker-compose -f stack/podman-compose.yml up -d --build",
    "stack:down": "docker-compose -f stack/podman-compose.yml down -v && docker-compose -f stack/docker-compose.reorg.yml down -v",
    "stack:reset": "npm run stack:down && npm run stack:rebuild",
    "stack:prune": "docker image prune -f",
    "stack:reorg:up": "docker-compose -f stack/docker-compose.reorg.yml up -d",
    "stack:logs": "docker-compose -f stack/podman-compose.yml logs -f --tail 50",
    "compile": "node contracts/compile.js",
    "attack": "cd sdk && npm run attack --",
    "attacks": "cd sdk && npm run attacks --",
    "attacks:provision": "cd sdk && npm run attacks:provision --",
    "all": "cd sdk && npm run all --",
    "e24": "cd sdk && npm run e24 --",
    "demo": "cd sdk && npm run demo --",
    "playground": "cd sdk && npm run playground --",
    "diag": "cd sdk && npm run diag --",
    "test": "npm run test:mermaid && cd sdk && npm run test:all --",
    "test:board": "cd sdk && npm run test:board --",
    "test:mermaid": "python3 sdk/test/mermaid_lint.py && node sdk/test/mermaid_parse.mjs",
    "typecheck": "cd sdk && npm run typecheck --",
    "sdk": "cd sdk && npm run",
    "install:sdk": "cd sdk && npm install",
    "measure": "cd sdk && npm run measure --",
    "m01": "cd sdk && npm run m01 --"
  }
}
